# Copy this file to .env and fill in real values. Never commit .env itself.

# Supabase project URL (same one already used client-side in lab.html/login.html)
SUPABASE_URL=https://biqoeaxxzegfvlxopazd.supabase.co

# Supabase SERVICE ROLE key — NOT the public anon key.
# Find it in: Supabase dashboard -> Project Settings -> API -> service_role secret.
# This key bypasses Row Level Security. It must only ever live here
# (server-side env vars), never in any HTML/JS file the browser loads.
SUPABASE_SERVICE_ROLE_KEY=

# A strong random secret you choose yourself, used to authenticate
# requests to /api/admin/set-premium. Generate one with:
#   openssl rand -hex 32
ADMIN_SECRET=

# Optional — defaults to 8080 if unset.
PORT=8080
